{
  "name": "jntua-attendance",
  "main": "expo/AppEntry.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "lint": "expo lint",
    "eas:init": "eas init",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform android",
    "update:staging": "eas update --channel staging --message \"Staging update\"",
    "update:production": "eas update --channel production --message \"Production update\"",
    "promote:production": "eas promote --channel staging --to production"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-splash-screen": "~57.0.10",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
